# Proof Gatekeeper — environment configuration.
# Copy to .env and fill in the secrets. NEVER commit .env.
# NEVER paste a private key, wallet seed phrase, or API key into a chat or
# into any prompt sent to a model.

# Port the HTTP service listens on.
PORT=3000

# HMAC secret from the Agent Games dashboard ("Rotate Secret").
# REQUIRED in production — the service refuses to start without it.
# This is the platform-generated value, never a local placeholder.
AGENT_GAMES_HMAC_SECRET=

# Kurier API key (zkVerify mainnet). Get one from the Kurier dashboard.
# Leave empty to run without Kurier (see REQUIRE_KURIER_FINALIZED).
KURIER_API_KEY=

# When true (default), APPROVE requires the Kurier job to reach "Finalized".
# When false, a locally verified proof is enough and the Kurier job id is
# only recorded for audit. With no KURIER_API_KEY configured and this set to
# true, every task is REJECTED with PROOF_NOT_FINALIZED (fail closed).
REQUIRE_KURIER_FINALIZED=true

# Max ms spent polling Kurier for Finalized (must fit inside the 60 s task deadline).
KURIER_POLL_BUDGET_MS=40000

# Poll interval for Kurier job status.
KURIER_POLL_INTERVAL_MS=2000

# The platform-registered gatekeeper verification-key hash (from /api/circuit-info).
# This is a protocol constant, not a secret. Do not change it.
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
